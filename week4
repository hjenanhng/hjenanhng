<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Simple Website</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <nav>
        <ul>
            <li><a href="#">Home</a></li>
            <li><a href="#">Tutorials</a></li>
            <li><a href="#">About</a></li>
            <li><a href="#">Newsletter</a></li>
            <li><a href="#">Contact</a></li>
        </ul>
    </nav>

    <section>
        <article>
            <h2>Just Another Day</h2>
            <p class="author">Written by Christina on January 11th</p>
            <p>This is my second blog entry, and I just wanted to check in on you</p>
        </article>

        <article>
            <h2>My First Blog Entry</h2>
            <p class="author">Written by Christina on January 10th</p>
            <p>I'm so happy to write my first blog entry - yay!</p>
        </article>
    </section>

    <footer>
        <p>&copy; Copyright 2009 Your name</p>
    </footer>

</body>
</html>
/* Tổng thể trang web */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f4f4;
}

/* Định dạng thanh menu (nav) */
nav {
    background-color: #333;
    padding: 10px 0;
}

nav ul {
    list-style-type: none;
    text-align: center;
    margin: 0;
    padding: 0;
}

nav ul li {
    display: inline;
    margin: 0 15px;
}

nav ul li a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

/* Nội dung bài viết */
section {
    width: 80%;
    margin: 20px auto;
    background-color: #e0e0e0; /* Màu nền xám nhạt như trong hình */
    padding: 20px;
}

article {
    margin-bottom: 30px;
}

h2 {
    margin-bottom: 5px;
}

.author {
    font-style: italic;
    font-size: 0.9em;
    color: #555;
}

/* Định dạng Footer (Theo đúng slide Solution) */
footer {
    background: #444;
    color: #fff;
    text-align: center;
    padding: 10px 0;
    position: fixed;
    bottom: 0;
    width: 100%;
}
